{
  "unstable": ["kv", "cron"],
  "tasks": {
    "dev": "deno run -A --unstable-kv --unstable-cron --watch --env-file=.env src/main.ts",
    "start": "deno run -A --unstable-kv --unstable-cron --env-file=.env src/main.ts",
    "start:prod": "deno run -A --unstable-kv --unstable-cron --env-file=.env.production src/main.ts",
    "test": "deno test -A --unstable-kv",
    "test:env": "deno test -A --unstable-kv --env-file=.env.test",
    "check": "deno check src/*.ts tests/*.ts scripts/*.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "db:generate": "deno run -A npm:drizzle-kit generate",
    "db:migrate": "deno run -A npm:drizzle-kit migrate",
    "seed": "deno run -A scripts/seed.ts",
    "ui:install": "cd ui && deno install",
    "ui:dev": "cd ui && deno task dev"
  },
  "imports": {
    "hono": "npm:hono@^4",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1",
    "zod": "npm:zod@^4",
    "bcryptjs": "npm:bcryptjs@^3",
    "jose": "npm:jose@^6",
    "drizzle-orm": "npm:drizzle-orm@^0.44",
    "drizzle-orm/libsql": "npm:drizzle-orm@^0.44/libsql",
    "drizzle-orm/libsql/migrator": "npm:drizzle-orm@^0.44/libsql/migrator",
    "drizzle-orm/sqlite-core": "npm:drizzle-orm@^0.44/sqlite-core",
    "drizzle-kit": "npm:drizzle-kit@^0.31",
    "@libsql/client": "npm:@libsql/client@^0.15",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "fmt": {
    "lineWidth": 90,
    "exclude": ["drizzle"]
  },
  "lint": {
    "exclude": ["ui", "drizzle"]
  }
}
